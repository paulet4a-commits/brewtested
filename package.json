{
  "name": "brewtested",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "tsx scripts/audit-product-keys.mjs && tsx scripts/audit-stale-products.mjs && tsx scripts/audit-affiliate-routing.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "audit:products": "tsx scripts/audit-stale-products.mjs",
    "audit:keys": "tsx scripts/audit-product-keys.mjs",
    "audit:affiliate": "tsx scripts/audit-affiliate-routing.mjs",
    "audit:claims": "tsx scripts/audit-claims.mjs",
    "audit:ai": "node scripts/audit-ai-readiness.mjs",
    "report:ai": "node scripts/audit-ai-readiness.mjs > docs/reports/ai-readiness-$(date +%Y-%m-%d).md",
    "report:affiliate": "tsx scripts/report-affiliate-status.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.2.0",
    "@astrojs/sitemap": "^3.3.0",
    "@astrojs/tailwind": "^5.1.4",
    "@tailwindcss/typography": "^0.5.19",
    "astro": "^5.8.0",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "tsx": "^4.22.2",
    "typescript": "^5.9.3"
  }
}
