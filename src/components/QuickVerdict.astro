---
interface Props {
  bestFor: string;
  avoidIf: string;
  evidenceBase: string;
  lastReviewed: string;
  bestAlternative?: string;
  internalLinks?: { label: string; href: string }[];
}

const { bestFor, avoidIf, evidenceBase, lastReviewed, bestAlternative, internalLinks } = Astro.props;
---

<div class="not-prose bg-amber-50 border border-amber-200 rounded-xl p-5 mb-8" itemscope itemtype="https://schema.org/Review">
  <p class="text-xs font-bold text-amber-700 uppercase tracking-widest mb-3">Quick Verdict</p>
  <dl class="space-y-2 text-sm text-gray-700">
    <div class="flex flex-col sm:flex-row gap-1 sm:gap-3">
      <dt class="font-semibold text-gray-900 sm:min-w-[140px]">Best for:</dt>
      <dd>{bestFor}</dd>
    </div>
    <div class="flex flex-col sm:flex-row gap-1 sm:gap-3">
      <dt class="font-semibold text-gray-900 sm:min-w-[140px]">Avoid if:</dt>
      <dd>{avoidIf}</dd>
    </div>
    {bestAlternative && (
      <div class="flex flex-col sm:flex-row gap-1 sm:gap-3">
        <dt class="font-semibold text-gray-900 sm:min-w-[140px]">Best alternative:</dt>
        <dd>{bestAlternative}</dd>
      </div>
    )}
    <div class="flex flex-col sm:flex-row gap-1 sm:gap-3">
      <dt class="font-semibold text-gray-900 sm:min-w-[140px]">Evidence base:</dt>
      <dd>{evidenceBase}</dd>
    </div>
    <div class="flex flex-col sm:flex-row gap-1 sm:gap-3">
      <dt class="font-semibold text-gray-900 sm:min-w-[140px]">Last reviewed:</dt>
      <dd itemprop="datePublished">{lastReviewed}</dd>
    </div>
  </dl>
  {internalLinks && internalLinks.length > 0 && (
    <div class="mt-4 pt-3 border-t border-amber-200">
      <p class="text-xs font-semibold text-amber-700 mb-2">Related BrewTested guides:</p>
      <ul class="flex flex-wrap gap-2">
        {internalLinks.map(link => (
          <li>
            <a href={link.href} class="text-xs text-amber-800 underline hover:text-amber-900">{link.label}</a>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>
