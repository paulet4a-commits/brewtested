---
import { products, getPreferredUrl, getPreferredMerchant } from '../data/products';

interface Props {
  productKey: string;
  badge?: string;
  pros?: string[];
  cons?: string[];
}

const { productKey, badge, pros, cons } = Astro.props;
const product = products[productKey];

if (!product) {
  throw new Error(`ProductCard: unknown product key "${productKey}". Add it to src/data/products.ts.`);
}

const url = getPreferredUrl(product);
const merchant = getPreferredMerchant(product);
const pageSlug = Astro.url.pathname;
const lastReviewed = product.lastReviewed ?? product.lastVerified;
---

<div class="border border-gray-200 rounded-xl p-5 my-6 not-prose">
  <div class="flex items-start justify-between gap-4 flex-wrap">
    <div>
      {badge && (
        <span class="inline-block text-xs font-bold uppercase tracking-wide text-amber-700 bg-amber-50 px-2 py-0.5 rounded mb-2">
          {badge}
        </span>
      )}
      <h3 class="text-lg font-bold text-gray-900">{product.name}</h3>
      <p class="text-sm text-gray-500 mt-0.5">
        Typical range: {product.priceRange} · <span class="text-gray-400 text-xs">Last reviewed {lastReviewed}</span>
      </p>
    </div>
    <a
      href={url}
      rel="sponsored nofollow noopener"
      target="_blank"
      class="shrink-0 bg-amber-600 hover:bg-amber-700 text-white font-semibold px-4 py-2 rounded-lg text-sm transition-colors plausible-affiliate-click"
      data-product={productKey}
      data-asin={product.asin}
      data-category={product.category}
      data-placement="ProductCard"
      data-merchant={merchant}
      data-page={pageSlug}
    >
      Check Current Price →
    </a>
  </div>

  {(pros || cons) && (
    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
      {pros && pros.length > 0 && (
        <div>
          <p class="font-semibold text-green-700 mb-1">Pros</p>
          <ul class="space-y-0.5 text-gray-700">
            {pros.map((p) => <li>✓ {p}</li>)}
          </ul>
        </div>
      )}
      {cons && cons.length > 0 && (
        <div>
          <p class="font-semibold text-red-600 mb-1">Cons</p>
          <ul class="space-y-0.5 text-gray-700">
            {cons.map((c) => <li>✗ {c}</li>)}
          </ul>
        </div>
      )}
    </div>
  )}
</div>

