---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const coffeeCategories = ['coffee', 'coffee-makers', 'espresso', 'pour-over', 'french-press', 'grinders', 'comparison', 'guide'];

const posts = (await getCollection('posts', ({ data }) => !data.draft && coffeeCategories.includes(data.category)))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryLabels: Record<string, string> = {
  'coffee-makers': 'Coffee Makers',
  'espresso': 'Espresso',
  'pour-over': 'Pour Over',
  'french-press': 'French Press',
  'grinders': 'Grinders',
  'coffee': 'Coffee',
  'comparison': 'Comparisons',
  'guide': 'Guides',
};

const featured = [
  { title: 'Best Coffee Maker Under $50', url: '/brewtested/posts/best-coffee-maker-under-50/', desc: 'Top drip machines for budget buyers.' },
  { title: 'Best Espresso Machine Under $100', url: '/brewtested/posts/best-espresso-machine-under-100/', desc: 'Real espresso without the premium price.' },
  { title: 'Best French Press Under $30', url: '/brewtested/posts/best-french-press-under-30/', desc: 'Rich, full-bodied coffee for under $30.' },
  { title: 'Best Burr Grinder Under $100', url: '/brewtested/posts/best-burr-grinder-under-100/', desc: 'Consistent grinds without breaking the bank.' },
  { title: 'Best Pour Over Coffee Maker', url: '/brewtested/posts/best-pour-over-coffee-maker/', desc: 'Clean, bright coffee — our top picks.' },
  { title: 'Best Moka Pot Under $30', url: '/brewtested/posts/best-moka-pot-under-30/', desc: 'Stovetop espresso for pennies per cup.' },
];
---

<BaseLayout title="Coffee Makers, Grinders & Espresso Reviews" description="Honest reviews of coffee makers, espresso machines, grinders, and pour over gear. Find the best coffee equipment for your budget.">
  <div class="mb-10">
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Coffee Equipment Reviews</h1>
    <p class="text-gray-600">Drip machines, espresso makers, grinders, French press, pour over — researched and compared for every budget.</p>
  </div>

  <!-- Featured Picks -->
  <section class="mb-12">
    <h2 class="text-xl font-bold text-gray-800 mb-4 border-b border-gray-200 pb-2">Featured Picks</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {featured.map((pick) => (
        <a href={pick.url} class="block border border-amber-200 rounded-lg p-4 hover:border-amber-400 hover:bg-amber-50 transition-colors">
          <div class="font-semibold text-amber-800 text-sm mb-1">{pick.title}</div>
          <div class="text-gray-600 text-xs">{pick.desc}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- All Coffee Articles -->
  <section>
    <h2 class="text-xl font-bold text-gray-800 mb-4 border-b border-gray-200 pb-2">All Coffee Reviews ({posts.length})</h2>
    <div class="grid gap-4">
      {posts.map((post) => (
        <article class="border border-gray-200 rounded-lg p-5 hover:border-amber-300 transition-colors">
          <span class="text-xs uppercase tracking-wide text-amber-700 font-semibold">{categoryLabels[post.data.category] ?? post.data.category}</span>
          <h3 class="text-lg font-bold mt-1 mb-1">
            <a href={`/brewtested/posts/${post.slug}/`} class="hover:text-amber-700">{post.data.title}</a>
          </h3>
          <p class="text-gray-600 text-sm">{post.data.description}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
