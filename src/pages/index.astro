---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  ;
---

<BaseLayout title="BrewTested" description="Honest reviews of coffee and kitchen gear. We test so you don't have to.">
  <div class="text-center mb-12">
    <h1 class="text-4xl font-bold text-gray-900 mb-4">Honest Coffee & Kitchen Reviews</h1>
    <p class="text-lg text-gray-600">Real specs. Real comparisons. No fluff.</p>
  </div>

  {posts.length > 0 ? (
    <div class="grid gap-6">
      {posts.map((post) => (
        <article class="border border-gray-200 rounded-lg p-6 hover:border-amber-300 transition-colors">
          <span class="text-xs uppercase tracking-wide text-amber-700 font-semibold">{post.data.category}</span>
          <h2 class="text-xl font-bold mt-1 mb-2">
            <a href={`/brewtested/posts/${post.slug}/`} class="hover:text-amber-700">{post.data.title}</a>
          </h2>
          <p class="text-gray-600 text-sm">{post.data.description}</p>
          <p class="text-xs text-gray-400 mt-3">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
        </article>
      ))}
    </div>
  ) : (
    <p class="text-center text-gray-500">First reviews coming soon.</p>
  )}
</BaseLayout>
