---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const recent = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 6);

const topPicks = [
  { title: 'Best Coffee Maker Under $50', url: '/brewtested/posts/best-coffee-maker-under-50/', badge: 'Top Pick', desc: 'Best drip machine for most people.' },
  { title: 'Best Espresso Machine Under $100', url: '/brewtested/posts/best-espresso-machine-under-100/', badge: 'Best Value', desc: 'Real espresso shots without the premium price.' },
  { title: 'Best French Press Under $30', url: '/brewtested/posts/best-french-press-under-30/', badge: 'Budget Win', desc: 'Rich, bold coffee for under $30.' },
  { title: 'Best Burr Grinder Under $100', url: '/brewtested/posts/best-burr-grinder-under-100/', badge: 'Editor\'s Choice', desc: 'Consistent grinds that improve every brew method.' },
];
---

<BaseLayout title="BrewTested" description="Honest, research-backed reviews of coffee makers, grinders, espresso machines, and kitchen gear. Buy right the first time.">

  <!-- Hero -->
  <div class="text-center mb-14">
    <h1 class="text-4xl font-bold text-gray-900 mb-4 leading-tight">
      Buy the Right Coffee Gear.<br class="hidden sm:block" /> First Time.
    </h1>
    <p class="text-lg text-gray-600 max-w-xl mx-auto mb-6">
      We dig through specs, owner reviews, and expert communities so you don't have to. Independent. No brand deals. No fluff.
    </p>
    <div class="flex gap-3 justify-center flex-wrap">
      <a href="/brewtested/coffee/" class="bg-amber-700 text-white px-5 py-2.5 rounded-lg font-semibold hover:bg-amber-800 transition-colors text-sm">Browse Coffee Gear</a>
      <a href="/brewtested/kitchen/" class="border border-gray-300 text-gray-700 px-5 py-2.5 rounded-lg font-semibold hover:border-amber-400 hover:text-amber-700 transition-colors text-sm">Kitchen Gear</a>
    </div>
  </div>

  <!-- Top Picks -->
  <section class="mb-14">
    <h2 class="text-xl font-bold text-gray-800 mb-5 border-b border-gray-200 pb-2">Our Top Picks Right Now</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {topPicks.map((pick) => (
        <a href={pick.url} class="block border border-gray-200 rounded-xl p-5 hover:border-amber-400 hover:shadow-sm transition-all group">
          <span class="inline-block text-xs font-bold uppercase tracking-wide text-amber-700 bg-amber-50 px-2 py-0.5 rounded mb-2">{pick.badge}</span>
          <div class="font-bold text-gray-900 group-hover:text-amber-700 transition-colors mb-1">{pick.title}</div>
          <div class="text-sm text-gray-500">{pick.desc}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Category Hubs -->
  <section class="mb-14">
    <h2 class="text-xl font-bold text-gray-800 mb-5 border-b border-gray-200 pb-2">Browse by Category</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <a href="/brewtested/coffee/" class="block bg-amber-50 border border-amber-200 rounded-xl p-6 hover:bg-amber-100 transition-colors">
        <div class="text-3xl mb-2">☕</div>
        <div class="font-bold text-lg text-gray-900 mb-1">Coffee Gear</div>
        <div class="text-sm text-gray-600">Drip machines, espresso, grinders, pour over, French press, Moka pots</div>
        <div class="text-amber-700 text-sm font-semibold mt-3">Browse all coffee reviews →</div>
      </a>
      <a href="/brewtested/kitchen/" class="block bg-gray-50 border border-gray-200 rounded-xl p-6 hover:bg-gray-100 transition-colors">
        <div class="text-3xl mb-2">🍳</div>
        <div class="font-bold text-lg text-gray-900 mb-1">Kitchen Gear</div>
        <div class="text-sm text-gray-600">Scales, kettles, milk frothers, and countertop appliances</div>
        <div class="text-amber-700 text-sm font-semibold mt-3">Browse kitchen reviews →</div>
      </a>
    </div>
  </section>

  <!-- Quick-decision comparison links -->
  <section class="mb-14">
    <h2 class="text-xl font-bold text-gray-800 mb-5 border-b border-gray-200 pb-2">Comparisons & Guides</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
      {[
        { title: 'AeroPress vs French Press', url: '/brewtested/posts/best-aeropress-vs-french-press/' },
        { title: 'Pour Over vs Drip Coffee', url: '/brewtested/posts/best-pour-over-vs-drip/' },
        { title: 'Nespresso vs Keurig', url: '/brewtested/posts/best-nespresso-vs-keurig/' },
        { title: 'French Press vs Moka Pot', url: '/brewtested/posts/best-french-press-vs-moka-pot/' },
        { title: 'Pour Over vs French Press', url: '/brewtested/posts/best-pour-over-vs-french-press/' },
        { title: 'Espresso at Home: Beginner Guide', url: '/brewtested/posts/best-espresso-at-home-beginners-guide/' },
      ].map((item) => (
        <a href={item.url} class="flex items-center gap-2 border border-gray-200 rounded-lg px-4 py-3 hover:border-amber-300 hover:text-amber-700 transition-colors font-medium">
          <span class="text-amber-500">→</span> {item.title}
        </a>
      ))}
    </div>
  </section>

  <!-- Recent Articles -->
  <section class="mb-10">
    <h2 class="text-xl font-bold text-gray-800 mb-5 border-b border-gray-200 pb-2">Recently Added</h2>
    <div class="grid gap-4">
      {recent.map((post) => (
        <article class="border border-gray-200 rounded-lg p-5 hover:border-amber-300 transition-colors">
          <span class="text-xs uppercase tracking-wide text-amber-700 font-semibold">{post.data.category}</span>
          <h3 class="text-lg font-bold mt-1 mb-1">
            <a href={`/brewtested/posts/${post.slug}/`} class="hover:text-amber-700">{post.data.title}</a>
          </h3>
          <p class="text-gray-600 text-sm">{post.data.description}</p>
        </article>
      ))}
    </div>
    <div class="text-center mt-6">
      <a href="/brewtested/coffee/" class="text-amber-700 font-semibold hover:underline text-sm">View all {allPosts.length} reviews →</a>
    </div>
  </section>

  <!-- Trust signals -->
  <div class="bg-gray-50 border border-gray-200 rounded-xl p-6 text-center text-sm text-gray-600">
    <p class="font-semibold text-gray-800 mb-1">How we research</p>
    <p>We analyze specs, dig through owner reviews on Amazon and Reddit, cross-reference common failure points, and synthesize honest recommendations. Affiliate links help us keep the site free — at no cost to you.</p>
    <a href="/brewtested/about/" class="text-amber-700 hover:underline mt-2 inline-block">Learn more about BrewTested →</a>
  </div>

</BaseLayout>
