---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { complaintIndex } from '../../../data/complaint-index';

const frequencyColors = {
  common: 'text-red-600 bg-red-50 border-red-200',
  occasional: 'text-amber-600 bg-amber-50 border-amber-200',
  rare: 'text-gray-500 bg-gray-50 border-gray-200',
};
---

<BaseLayout
  title="Coffee Gear Complaint Index — Owner Issues by Product | BrewTested"
  description="BrewTested's structured complaint index: common owner issues, avoid-if criteria, and maintenance risk ratings for top espresso grinders and machines. Research-based."
>
  <div class="mb-8">
    <p class="text-xs uppercase tracking-widest text-amber-600 font-semibold mb-2">Original Data</p>
    <h1 class="text-3xl font-bold text-gray-900 mb-3">Coffee Gear Complaint Index</h1>
    <p class="text-gray-600 text-lg leading-relaxed mb-4">
      Structured owner complaint patterns for top espresso grinders and machines. Sourced from Amazon verified reviews, r/espresso, and Home-Barista forums. Updated May 2026.
    </p>
    <div class="flex gap-3 text-sm">
      <a href="/data/complaint-index.json" class="inline-flex items-center gap-1 text-amber-700 hover:text-amber-900 underline font-medium">
        JSON export
      </a>
      <span class="text-gray-400">·</span>
      <a href="/methodology/" class="text-amber-700 hover:text-amber-900 underline">Research methodology</a>
    </div>
  </div>

  <div class="mb-6 text-sm text-gray-600 bg-gray-50 rounded-lg p-4">
    <strong>Frequency labels:</strong>
    <span class="inline-block ml-2 px-2 py-0.5 text-xs border rounded text-red-600 bg-red-50 border-red-200">common</span> reported by many owners ·
    <span class="inline-block ml-1 px-2 py-0.5 text-xs border rounded text-amber-600 bg-amber-50 border-amber-200">occasional</span> reported by some ·
    <span class="inline-block ml-1 px-2 py-0.5 text-xs border rounded text-gray-500 bg-gray-50 border-gray-200">rare</span> edge cases only
  </div>

  <div class="space-y-8" itemscope itemtype="https://schema.org/Dataset">
    <meta itemprop="name" content="BrewTested Coffee Gear Complaint Index" />
    <meta itemprop="description" content="Structured owner complaint patterns for espresso grinders and machines, with avoid-if criteria and maintenance risk ratings." />
    <meta itemprop="url" content="https://brewtested.pulsedash-app.com/data/coffee-gear-complaint-index/" />

    {complaintIndex.map(product => (
      <article class="border border-gray-200 rounded-xl p-6 bg-white shadow-sm">
        <div class="flex items-start justify-between mb-4">
          <h2 class="text-xl font-bold text-gray-900">{product.productName}</h2>
          <span class={`text-xs font-semibold px-2 py-1 rounded border ${
            product.maintenanceRisk === 'low' ? 'text-green-700 bg-green-50 border-green-200' :
            product.maintenanceRisk === 'medium' ? 'text-amber-700 bg-amber-50 border-amber-200' :
            'text-red-700 bg-red-50 border-red-200'
          }`}>
            Maintenance risk: {product.maintenanceRisk}
          </span>
        </div>

        <div class="mb-4">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Owner Complaints</h3>
          <ul class="space-y-2">
            {product.complaints.map(c => (
              <li class="flex items-start gap-2 text-sm">
                <span class={`mt-0.5 flex-shrink-0 text-xs px-1.5 py-0.5 border rounded font-medium ${frequencyColors[c.frequencyLabel]}`}>
                  {c.frequencyLabel}
                </span>
                <span class="text-gray-600">
                  {c.summary}
                  {c.isDesignTradeoff && <span class="ml-1 text-xs text-gray-400 italic">(design trade-off)</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>

        {product.avoidIf.length > 0 && (
          <div class="mb-4">
            <h3 class="text-sm font-semibold text-gray-700 mb-2">Avoid if:</h3>
            <ul class="list-disc list-inside space-y-1 text-sm text-gray-600">
              {product.avoidIf.map(a => <li>{a}</li>)}
            </ul>
          </div>
        )}

        <div class="mt-4 pt-3 border-t border-gray-100 flex justify-between text-xs text-gray-400">
          <span>Sources: {product.sourceTypes.join(', ')}</span>
          <span>Reviewed: {product.lastReviewed}</span>
        </div>
      </article>
    ))}
  </div>

  <div class="mt-10 pt-6 border-t border-gray-200 text-sm text-gray-500 space-y-2">
    <p>Complaints are categorized from verified owner feedback. Design trade-offs are inherent product characteristics, not defects. Confidence ratings reflect volume and consistency of feedback available.</p>
    <p>
      <a href="/methodology/" class="text-amber-700 underline">Research methodology</a> ·
      <a href="/data/complaint-index.json" class="text-amber-700 underline">JSON export</a> ·
      <a href="/data/espresso-setup-matrix/" class="text-amber-700 underline">Setup matrix</a>
    </p>
  </div>
</BaseLayout>
