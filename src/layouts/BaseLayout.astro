---
interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  affiliateDisclosure?: boolean;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  affiliateDisclosure = false,
} = Astro.props;

const siteTitle = 'BrewTested';
const fullTitle = title === siteTitle ? title : `${title} | ${siteTitle}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://brewtested.pulsedash-app.com';

// Static branded OG image — consistent editorial identity, not product photography
const ogImage = `${siteURL}/og-default.png`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'BrewTested',
  url: siteURL,
  description: 'Independent research-based reviews of coffee makers, grinders, espresso machines, and kitchen gear.',
};

const articleSchema = pubDate ? {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  url: canonicalURL.toString(),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  publisher: { '@type': 'Organization', name: 'BrewTested', url: siteURL },
  image: ogImage,
} : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="google-site-verification" content="sATNOe6XpoOMvTSDUnXANJ-Y0TceU4_FdRINdWt0oJE" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={pubDate ? 'article' : 'website'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="1500" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    {updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}
    <!-- Plausible Analytics (free, privacy-first) -->
    <script defer data-domain="brewtested.pulsedash-app.com" src="https://plausible.io/js/script.outbound-links.js"></script>
  </head>
  <body class="min-h-screen bg-white text-gray-900 font-sans">
    <header class="border-b border-gray-200 py-4 px-6 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-amber-700">☕ BrewTested</a>
      <nav class="flex gap-6 text-sm">
        <a href="/coffee/" class="hover:text-amber-700">Coffee</a>
        <a href="/kitchen/" class="hover:text-amber-700">Kitchen</a>
        <a href="/about/" class="hover:text-amber-700">About</a>
      </nav>
    </header>

    {affiliateDisclosure && (
      <div class="bg-amber-50 border-b border-amber-200 px-6 py-2 text-sm text-amber-800">
        <strong>Disclosure:</strong> This page contains affiliate links. If you purchase through them, I earn a small commission at no extra cost to you.
      </div>
    )}

    <main class="max-w-3xl mx-auto px-6 py-10">
      <slot />
    </main>

    <footer class="border-t border-gray-200 py-8 px-6 text-center text-sm text-gray-500">
      <p class="font-medium text-gray-600">As an Amazon Associate I earn from qualifying purchases.</p>
      <p class="mt-1">© {new Date().getFullYear()} BrewTested. Content researched with AI assistance and reviewed by a human editor.</p>
      <p class="mt-1">
        <a href="/privacy/" class="hover:underline">Privacy Policy</a> ·
        <a href="/about/" class="hover:underline">About</a>
      </p>
    </footer>
  </body>
</html>
